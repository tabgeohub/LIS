# Probe-only process; no SESSION_SECRET, PG*, Redis, Keycloak or ArcGIS secrets needed.
IOS_HOST=127.0.0.1
IOS_PORT=5001
IOS_PUBLIC_BASE_URL=http://acc-lis.rws.nl/backend/
# Optional explicit file loader: export IOS_ENV_FILE=/absolute/operator/owned/path
# Existing environment takes precedence. Baseline .env is never implicitly loaded.
