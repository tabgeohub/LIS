# Additive probe-only image. No .env copied, no baseline CMD or image replaced.
FROM node:24-slim AS build
WORKDIR /usr/src/app
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json tsconfig-ios.json ./
COPY src ./src
RUN ./node_modules/.bin/tsc -p tsconfig-ios.json

FROM node:24-slim
WORKDIR /usr/src/app
ENV NODE_ENV=production IOS_HOST=0.0.0.0 IOS_PORT=5001
COPY --from=build /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist-ios ./dist-ios
USER node
EXPOSE 5001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
 CMD node -e "fetch('http://127.0.0.1:5001/api/ios/bootstrap/probe').then(async r=>{const b=await r.json();process.exit(r.status===200&&b.service==='lis-ios-bootstrap'&&b.version===1?0:1)}).catch(()=>process.exit(1))"
CMD ["node", "dist-ios/server-ios.js"]
